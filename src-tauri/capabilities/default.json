{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$DOCUMENT/Cotizaciones/*.pdf" }]
    },
    "fs:default",
    "fs:allow-exists",
    "fs:write-files",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": ["$DOCUMENT/**"]
    },
    "sql:default",
    "sql:allow-execute"
  ]
}
